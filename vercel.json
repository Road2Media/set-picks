          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/tour-stats-data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/phish-setlist-prediction-game",
      "headers": [
        {
