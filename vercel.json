{
  "ignoreCommand": "bash scripts/vercel-should-build.sh",
  "functions": {
    "api/invite.js": {
      "includeFiles": "dist/**"
    }
  },
  "redirects": [
    {
      "source": "/tour-stats/summer-tour-2026",
      "destination": "/tour-stats/2026-summer-tour",
      "permanent": true
    },
    {
      "source": "/ig/how",
      "destination": "/how-it-works?utm_source=instagram&utm_medium=social&utm_campaign=seo_geo&utm_content=how-it-works",
      "permanent": false
    },
    {
      "source": "/ig/card",
      "destination": "/phish-setlist-prediction-game?utm_source=instagram&utm_medium=social&utm_campaign=seo_geo&utm_content=card-open",
      "permanent": false
    },
    {
      "source": "/ig/score",
      "destination": "/how-scoring-works?utm_source=instagram&utm_medium=social&utm_campaign=seo_geo&utm_content=how-scoring-works",
      "permanent": false
    },
    {
      "source": "/ig/about",
      "destination": "/about?utm_source=instagram&utm_medium=social&utm_campaign=seo_geo&utm_content=about",
      "permanent": false
    },
    {
      "source": "/ig/stats",
      "destination": "/tour-stats?utm_source=instagram&utm_medium=social&utm_campaign=seo_geo&utm_content=tour-stats",
      "permanent": false
    },
    {
      "source": "/th/how",
      "destination": "/how-it-works?utm_source=threads&utm_medium=social&utm_campaign=seo_geo&utm_content=how-it-works",
      "permanent": false
    },
    {
      "source": "/th/card",
      "destination": "/phish-setlist-prediction-game?utm_source=threads&utm_medium=social&utm_campaign=seo_geo&utm_content=card-open",
      "permanent": false
    },
    {
      "source": "/th/score",
      "destination": "/how-scoring-works?utm_source=threads&utm_medium=social&utm_campaign=seo_geo&utm_content=how-scoring-works",
      "permanent": false
    },
    {
      "source": "/th/about",
      "destination": "/about?utm_source=threads&utm_medium=social&utm_campaign=seo_geo&utm_content=about",
      "permanent": false
    },
    {
      "source": "/th/stats",
      "destination": "/tour-stats?utm_source=threads&utm_medium=social&utm_campaign=seo_geo&utm_content=tour-stats",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "click.setlistpickem.com"
        }
      ],
      "destination": "/api/email-click?path=:path*"
    },
    {
      "source": "/__/firebase/init.json",
      "destination": "https://set-picks.firebaseapp.com/__/firebase/init.json"
    },
    {
      "source": "/__/auth/(.*)",
      "destination": "https://set-picks.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon/favicon.ico"
    },
    {
      "source": "/invite/:handle",
      "destination": "/api/invite?handle=:handle"
    },
    {
      "source": "/join/:code",
      "destination": "/api/invite?code=:code"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/setup",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/login",
      "destination": "/login/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/user/(.*)",
      "destination": "/spa-boot/index.html"
    },
    {
      "source": "/password-reset-complete",
      "destination": "/spa-boot/index.html"
    },
    {
      "source": "/comms-preview",
      "destination": "/spa-boot/index.html"
    },
    {
      "source": "/join",
      "destination": "/spa-boot/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com https://www.gstatic.com https://apis.google.com https://www.recaptcha.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.cloudfunctions.net https://*.firebaseapp.com https://*.firebasestorage.app https://firebasestorage.googleapis.com https://storage.googleapis.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://analytics.google.com https://www.google.com https://www.gstatic.com https://phish.in wss://*.googleapis.com wss://*.firebaseio.com; frame-src https://accounts.google.com https://*.firebaseapp.com https://www.google.com https://www.recaptcha.net https://recaptcha.google.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/__/auth/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/__/firebase/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/bimi/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/svg+xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
