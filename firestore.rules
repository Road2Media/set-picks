rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    /**
     * Admin custom claim (issue #139 PR B). Set via `setAdminClaim` callable.
     * The legacy email fallback is removed in PR B; the claim is the single
     * source of truth for write authorization against admin surfaces.
     */
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    /**
     * Join flow: `members` grows by one and includes the caller. `from_membership`
     * pools (#417) also stamp `memberJoinedAt.{uid}` on self-join.
     */
    function isPoolMembersSelfJoin() {
      return signedIn()
        && resource.data.members is list
        && request.resource.data.members is list
        && !(request.auth.uid in resource.data.members)
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1;
    }

    function isPoolSelfJoinMembershipTimestamp() {
      let prior = resource.data.get('memberJoinedAt', {});
      let next = request.resource.data.memberJoinedAt;
      // Only the joiner's key may be added; existing timestamps must be unchanged.
      return next is map
        && next.diff(prior).affectedKeys().hasOnly([request.auth.uid])
        && request.auth.uid in next
        && !(request.auth.uid in prior)
        && next[request.auth.uid] is string;
    }

    function isPoolSelfJoin() {
      return isPoolMembersSelfJoin()
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberJoinedAt'])
            && isPoolSelfJoinMembershipTimestamp()
          )
        );
    }

    match /pools/{poolId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        || isPoolSelfJoin();
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    /**
     * `users/{uid}` — profile docs (issue #139 PR B).
     * Reads stay auth'd-only so peer lookups (`fetchPoolMemberProfiles`,
     * `fetchPublicProfileByUid/Handle`) keep working. Writes are restricted to
     * the owning user or an admin claim holder. Admin-SDK writes from
     * `rollupScoresForShow` bypass rules entirely.
     *
     * #244 (materialize season aggregates) adds server-written fields
     * `wins`, `seasonStats.{tourKey}`, `seasonStatsSnapshotAt`, and
     * `seasonStatsThroughShow` to this doc. Reads stay open; Admin-SDK
     * writes from `rollupScoresForShow` still bypass these rules, and
     * the owner/admin write path is unchanged (a determined owner could
     * already overwrite `totalPoints` pre-#244 — same posture applies
     * to the new fields; tightening to a server-only field-set is
     * tracked as a follow-up if peer tampering becomes a concern).
     */
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn()
        && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      /**
       * Private per-device FCM token docs (issue #273):
       * users/{uid}/private_fcmTokens/{tokenId}
       *
       * The issue suggested `.../private/fcmTokens/{tokenId}`, but Firestore
       * doc paths must have an even number of segments. This equivalent keeps
       * the same isolation semantics while using a valid path.
       */
      match /private_fcmTokens/{tokenId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      /**
       * In-app comms inbox (issue #120 / epic #272 / #513): recap + editorial messages.
       * Clients read; Admin SDK / Cloud Functions create. Owners may set `readAt` /
       * `archivedAt` and may hard-delete their own docs. Payload stays server-owned.
       */
      match /commsInbox/{messageId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if false;
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.templateId == resource.data.templateId
          && request.resource.data.payload == resource.data.payload
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readAt', 'archivedAt']);
      }
    }

    /**
     * `picks/{pickId}` — per-user pick docs (issue #139 PR B).
     * Create/update must carry `userId == auth.uid` on the incoming payload,
     * and update/delete additionally require the existing owner to match
     * (prevents ownership handoff via overwrite). Admin claim holders can
     * recover/repair any pick. Admin-SDK writes (grading) bypass rules.
     */
    match /picks/{pickId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && (
          (
            resource.data.userId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
          )
          || isAdmin()
        );
      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    /**
     * `official_setlists/{showDate}` — authoritative, admin-authored setlists
     * (issue #139 PR B). Reads stay auth'd-only so every user can see the
     * live/final setlist; writes require the admin claim. Admin-SDK writes
     * from scheduled / manual live-setlist automation bypass rules.
     */
    match /official_setlists/{showDate} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    /**
     * Live setlist automation state (issue #164). Written by Cloud Functions
     * (Admin SDK); admin UI reads pause/backoff metadata. Gated on the admin
     * claim as of PR B (previously: hard-coded email).
     */
    match /live_setlist_automation/{showDate} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /**
     * Admin picks-lock override (#522). Written by `lockPicksForShowNow` callable
     * (Admin SDK); signed-in clients read to honor effective lock state.
     */
    match /show_lock_state/{showDate} {
      allow read: if signedIn();
      allow write: if false;
    }

    /**
     * Rollup audit log (issue #139 PR B). Written server-side by
     * `rollupScoresForShow` after every invocation; surfaces a
     * Firestore-visible "last rollup ran at…" signal. Admin-only reads; no
     * client writes (Admin SDK bypasses rules on the write path).
     */
    match /rollup_audit/{showDate} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /**
     * Night-of show narrative context (#572). Written by Cloud Functions when
     * official setlists are saved / rollup runs; clients do not access.
     */
    match /comms_show_context/{showDate} {
      allow read, write: if false;
    }

    /**
     * Global Stats leaderboards (#1004). Written by Cloud Functions Admin SDK
     * from `users` career / seasonStats fields. Authenticated clients may read
     * the top-50 boards; no client writes.
     */
    match /global_stats_leaderboards/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    /**
     * Aggregate-only public tour stats for SEO (#665). Written by Cloud Functions
     * Admin SDK from official_setlists; never contains full per-show setlists.
     * Doc `_index` lists tours for the public picker. Clients may read; no writes.
     */
    match /public_tour_stats/{tourSlug} {
      allow read: if true;
      allow write: if false;
    }

    /** Server-written Phish.net show calendar; clients read only (issue #160). */
    match /show_calendar/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    /**
     * FCM delivery dedupe log (issues #275–#276). Written only by Cloud Functions
     * Admin SDK; clients must not read or tamper with send state.
     */
    match /fcm_notification_log/{docId} {
      allow read, write: if false;
    }

    /**
     * Tour-level once-ever gate for production `tour_recap` (#1033).
     * Written only by Cloud Functions Admin SDK after end-of-tour fan-out
     * (or archive skip / ops seed). Clients must not read or tamper.
     */
    match /comms_tour_recap_state/{tourId} {
      allow read, write: if false;
    }

    /**
     * Process-level once-ever gate (#1035). Document id is
     * `{triggerId}:{scope}`. `tour_recap` also mirrors
     * `comms_tour_recap_state`. Written only by Admin SDK. Clients have no access.
     */
    match /comms_process_state/{processId} {
      allow read, write: if false;
    }

    /**
     * Email suppression list for comms deliverability (#442). Written only by
     * Cloud Functions (webhooks + unsubscribe endpoint); clients must not access.
     */
    match /email_suppression/{docId} {
      allow read, write: if false;
    }

    /**
     * Resend email open/click plane (#512 Slice A). Written only by
     * `commsResendWebhook` (Admin SDK). Clients have no access — Slice B
     * reminder audience resolution is server-side.
     */
    match /comms_email_engagement/{resendEmailId} {
      allow read, write: if false;
    }

    /**
     * Self-serve account deletion audit (`deleteAccountWithAudit` callable).
     * Written only via Admin SDK; no client access.
     */
    match /account_deletion_reports/{reportId} {
      allow read, write: if false;
    }

    /**
     * Password-reset rate limit (#1049). Doc ids are hashes of the address
     * or caller IP. Written only by `requestPasswordResetEmail` (Admin SDK).
     * Clients must not read counts or seed the window.
     */
    match /password_reset_rate/{docId} {
      allow read, write: if false;
    }

  }
}
